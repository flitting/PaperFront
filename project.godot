; Paper War — independent desktop RTS
config_version=5

[application]
config/name="纸境战线 · Paper Front"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=810
window/size/min_width=1100
window/size/min_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]
camera_pan_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
camera_pan_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
camera_pan_forward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
camera_pan_backward={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

[rendering]
camera/depth_of_field/depth_of_field_bokeh_quality=1
camera/depth_of_field/depth_of_field_bokeh_shape=1
camera/depth_of_field/depth_of_field_use_jitter=false
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/ssao/quality=2
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.17, 0.13, 0.095, 1)

[physics]
common/physics_ticks_per_second=30

[audio]
driver/enable_input=false
