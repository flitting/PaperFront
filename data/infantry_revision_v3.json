        "under_attack": [
          "敌人开火了，找掩护。",
          "我们挨打了，帮一把！",
          "别散开，稳住！"
        ],
        "death": [
          "啊——！",
          "兄弟，救我！",
          "别…丢下我！",
          "呃！顶…住…"
        ]
      },
